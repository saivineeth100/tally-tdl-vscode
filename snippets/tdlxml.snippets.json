            "   <ORIGINALNAME>${2:FormalName}</ORIGINALNAME>",
            "   <BASEUNITS>${1:UnitName}</BASEUNITS>",
            "   $0",
            "</UNIT>"
        ],
        "description": "Unit object for Tally XML"
    },
    "Tally Godown": {
