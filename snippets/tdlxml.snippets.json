{
    "Create Full Report": {
        "prefix": "Report",
        "body": [
            "<REPORT ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <FORM>${1:reportname}</FORM>",
            "</REPORT>",
            "<FORM ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <PARTS>${1:reportname}<PARTS>",
            "</FORM>",
            "<PART ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <LINES>${1:reportname}</LINES>",
            "</PART>",
            "<LINE ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <FIELDS>${2:fieldname},${3:fieldname2}</FIELDS>",
            "</LINE>",
            "<FIELD ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${2:fieldname}\">",
            "   <SETAS>\\$${4:someval}</SETAS>",
            "</FIELD>",
            "<FIELD ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${3:fieldname2}\">",
            "   <SETAS>\\$${5:someval2}</SETAS>",
            "</FIELD>"
        ],
        "description": "Creates Report with form,part,line and fields"
    },
    "Create Full Report with Collection": {
        "prefix": "Report",
        "body": [
            "<REPORT ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <FORM>${1:reportname}</FORM>",
            "</REPORT>",
            "<FORM ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <PARTS>${1:reportname}<PARTS>",
            "</FORM>",
            "<PART ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <LINES>${1:reportname}:${2:collectionName}</LINES>",
            "</PART>",
            "<LINE ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${1:reportname}\">",
            "   <FIELDS>${3:fieldname},${4:fieldname2}</FIELDS>",
            "</LINE>",
            "<FIELD ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${3:fieldname}\">",
            "   <SETAS>\\$${5:someval}</SETAS>",
            "</FIELD>",
            "<FIELD ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${4:fieldname2}\">",
            "   <SETAS>\\$${6:someval2}</SETAS>",
            "</FIELD>",
            "<COLLECTION ISMODIFY=\"No\" ISFIXED=\"No\" ISINITIALIZE=\"No\" ISOPTION=\"No\" ISINTERNAL=\"No\" NAME=\"${2:collectionName}\">",
            "   <TYPE>${7:objectType}</TYPE>",
            "</COLLECTION>"
        ],
        "description": "Creates Report with form,part,line,fields and collection"
    },
    "Tally XML Envelope: Import Masters": {
        "prefix": "Create Masters",
        "body": [
            "<ENVELOPE>",
            "    <HEADER>",
            "        <VERSION>1</VERSION>",
            "        <TALLYREQUEST>Import</TALLYREQUEST>",
            "        <TYPE>Data</TYPE>",
            "        <ID>All Masters</ID>",
            "    </HEADER>",
            "    <BODY>",
            "        <DESC>",
            "            <STATICVARIABLES>",
            "                <SVMSTIMPORTFORMAT>XML</SVMSTIMPORTFORMAT>",
            "                <SVCURRENTCOMPANY>${1:Company Name}</SVCURRENTCOMPANY>",
            "            </STATICVARIABLES>",
            "            <TALLYMESSAGE>",
            "                $0",
            "            </TALLYMESSAGE>",
            "        </DESC>",
            "    </BODY>",
            "</ENVELOPE>"
        ],
        "description": "Tally XML Envelope for Importing Masters (Ledgers, Groups, Items, etc.)"
    },
    "Tally XML Envelope: Import Vouchers": {
        "prefix": "Create Vouchers",
        "body": [
            "<ENVELOPE>",
            "    <HEADER>",
            "        <VERSION>1</VERSION>",
            "        <TALLYREQUEST>Import</TALLYREQUEST>",
            "        <TYPE>Data</TYPE>",
            "        <ID>Vouchers</ID>",
            "    </HEADER>",
            "    <BODY>",
            "        <DESC>",
            "            <STATICVARIABLES>",
            "                <SVVCHIMPORTFORMAT>XML</SVVCHIMPORTFORMAT>",
            "                <SVCURRENTCOMPANY>${1:Company Name}</SVCURRENTCOMPANY>",
            "            </STATICVARIABLES>",
            "            <TALLYMESSAGE xmlns:UDF=\"TallyUDF\">",
            "                $0",
            "            </TALLYMESSAGE>",
            "        </DESC>",
            "    </BODY>",
            "</ENVELOPE>"
        ],
        "description": "Tally XML Envelope for Importing Vouchers"
    },
    "Tally XML Envelope: Export Collection": {
        "prefix": "Get Data from custom TDL Collection",
        "body": [
            "<ENVELOPE>",
            "    <HEADER>",
            "        <VERSION>1</VERSION>",
            "        <TALLYREQUEST>Export</TALLYREQUEST>",
            "        <TYPE>Collection</TYPE>",
            "        <ID>${1:CollectionName}</ID>",
            "    </HEADER>",
            "    <BODY>",
            "        <DESC>",
            "            <STATICVARIABLES>",
            "                <SVEXPORTFORMAT>\\$\\$SysName:XML</SVEXPORTFORMAT>",
            "                <SVCURRENTCOMPANY>${2:Company Name}</SVCURRENTCOMPANY>",
            "            </STATICVARIABLES>",
            "            <TDL>",
            "                <TDLMESSAGE>",
            "                    <COLLECTION NAME=\"${1:CollectionName}\">",
            "                        <TYPE>${3|Ledger,Voucher,Group,StockItem|}</TYPE>",
            "                        <NATIVEMETHOD>$0</NATIVEMETHOD>",
            "                    </COLLECTION>",
            "                </TDLMESSAGE>",
            "            </TDL>",
            "        </DESC>",
            "    </BODY>",
            "</ENVELOPE>"
        ],
        "description": "Tally XML Envelope for Exporting a Collection via TDL"
    },
    "Tally XML Envelope: Export Default Collection": {
        "prefix": "Get Data from existing Collection",
        "body": [
            "<ENVELOPE>",
            "    <HEADER>",
            "        <VERSION>1</VERSION>",
            "        <TALLYREQUEST>Export</TALLYREQUEST>",
            "        <TYPE>Collection</TYPE>",
            "        <ID>${1|Ledger,Group,Voucher,StockItem,Godown,Unit|}</ID>",
            "    </HEADER>",
            "    <BODY>",
            "        <DESC>",
            "            <STATICVARIABLES>",
            "                <SVEXPORTFORMAT>XML</SVEXPORTFORMAT>",
            "                <SVCURRENTCOMPANY>${2:Company Name}</SVCURRENTCOMPANY>",
            "            </STATICVARIABLES>",
            "        </DESC>",
            "    </BODY>",
            "</ENVELOPE>"
        ],
        "description": "Tally XML Envelope for Exporting Default Collections"
    },
    "Tally Ledger": {
        "prefix": "Ledger",
        "body": [
            "<LEDGER NAME=\"${1:LedgerName}\" Action=\"${2|Create,Alter,Delete|}\">",
            "   <NAME>${1:LedgerName}</NAME>",
            "   <PARENT>${3:Sundry Debtors}</PARENT>",
            "   <OPENINGBALANCE>${4:0}</OPENINGBALANCE>",
            "   $0",
            "</LEDGER>"
        ],
        "description": "Ledger object for Tally XML"
    },
    "Tally Group": {
        "prefix": "Group",
        "body": [
            "<GROUP NAME=\"${1:GroupName}\" Action=\"${2|Create,Alter,Delete|}\">",
            "   <NAME>${1:GroupName}</NAME>",
            "   <PARENT>${3:Primary}</PARENT>",
            "   $0",
            "</GROUP>"
        ],
        "description": "Group object for Tally XML"
    },
    "Tally Stock Item": {
        "prefix": "StockItem",
        "body": [
