            "   <PARENT>${3:Primary}</PARENT>",
            "   <BASEUNITS>${4:Nos}</BASEUNITS>",
            "   $0",
            "</STOCKITEM>"
        ],
        "description": "Stock Item object for Tally XML"
    },
    "Tally Stock Group": {
