            "</GODOWN>"
        ],
        "description": "Godown object for Tally XML"
    },
    "Tally Accounting Voucher": {
        "prefix": "Voucher Accounting",
        "body": [
            "<VOUCHER VCHTYPE=\"${1:Sales}\" ACTION=\"${2|Create,Alter,Delete|}\" OBJVIEW=\"Accounting Voucher View\">",
            "   <DATE>${3:20240401}</DATE>",
            "   <VOUCHERTYPENAME>${1:Sales}</VOUCHERTYPENAME>",
            "   <PARTYLEDGERNAME>${4:PartyName}</PARTYLEDGERNAME>",
            "   <PERSISTEDVIEW>Accounting Voucher View</PERSISTEDVIEW>",
            "   <ALLLEDGERENTRIES.LIST>",
            "       <LEDGERNAME>${4:PartyName}</LEDGERNAME>",
            "       <ISDEEMEDPOSITIVE>${5|Yes,No|}</ISDEEMEDPOSITIVE>",
            "       <AMOUNT>${6:-1000.00}</AMOUNT>",
            "   </ALLLEDGERENTRIES.LIST>",
            "   <ALLLEDGERENTRIES.LIST>",
            "       <LEDGERNAME>${7:Sales Account}</LEDGERNAME>",
            "       <ISDEEMEDPOSITIVE>${8|No,Yes|}</ISDEEMEDPOSITIVE>",
            "       <AMOUNT>${9:1000.00}</AMOUNT>",
            "   </ALLLEDGERENTRIES.LIST>",
            "   $0",
            "</VOUCHER>"
        ],
        "description": "Accounting Voucher for Tally XML"
    },
    "Tally Invoice Voucher": {
        "prefix": "Voucher Invoice",
        "body": [
            "<VOUCHER VCHTYPE=\"${1:Sales}\" ACTION=\"${2|Create,Alter,Delete|}\" OBJVIEW=\"Invoice Voucher View\">",
            "   <DATE>${3:20240401}</DATE>",
            "   <VOUCHERTYPENAME>${1:Sales}</VOUCHERTYPENAME>",
            "   <PARTYLEDGERNAME>${4:PartyName}</PARTYLEDGERNAME>",
            "   <PERSISTEDVIEW>Invoice Voucher View</PERSISTEDVIEW>",
            "   <ALLLEDGERENTRIES.LIST>",
            "       <LEDGERNAME>${4:PartyName}</LEDGERNAME>",
            "       <ISDEEMEDPOSITIVE>${5|Yes,No|}</ISDEEMEDPOSITIVE>",
            "       <AMOUNT>${6:-1000.00}</AMOUNT>",
            "   </ALLLEDGERENTRIES.LIST>",
            "   <ALLLEDGERENTRIES.LIST>",
            "       <LEDGERNAME>${7:Sales Account}</LEDGERNAME>",
            "       <ISDEEMEDPOSITIVE>${8|No,Yes|}</ISDEEMEDPOSITIVE>",
            "       <AMOUNT>${9:1000.00}</AMOUNT>",
            "       <INVENTORYALLOCATIONS.LIST>",
            "           <STOCKITEMNAME>${10:ItemName}</STOCKITEMNAME>",
            "           <RATE>${11:100.00}/nos</RATE>",
            "           <AMOUNT>${9:1000.00}</AMOUNT>",
            "           <BILLEDQTY>${12:10} nos</BILLEDQTY>",
            "       </INVENTORYALLOCATIONS.LIST>",
            "   </ALLLEDGERENTRIES.LIST>",
            "   $0",
            "</VOUCHER>"
        ],
        "description": "Invoice Voucher with Inventory for Tally XML"
    }
}