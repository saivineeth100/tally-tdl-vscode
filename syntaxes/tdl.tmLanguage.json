{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Tally TDL",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#classes"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#constants"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.tdl",
					"begin": ";;",
					"beginCaptures": {},
					"end": "\\n"
				},
				{
					"name": "comment.block.tdl",
					"begin": "\/\\*",
					"beginCaptures": {},
					"end": "\\*\/"
				}
			]
		},
		"classes": {
			"patterns": [
				{
					"begin": "\\[\\s*(#?)\\s*([^:\\s]+)\\s*:\\s*([^\\]]+)\\s*",
					"beginCaptures": {
						"1": {
							"name": "storage.modifier"
						},
						"2": {
							"name": "storage.type"
						},
						"3": {
							"name": "entity.name.class"
						}
					},
					"end": "\\]"
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"begin": "^\\s*([a-zA-Z0-9_\\s]+)\\s*:",
					"beginCaptures": {
						"1": {
							"name": "keyword.control"
						}
					},
					"end": "\\s*(?:.*)$"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.tdl",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.tdl",
					"match": "\\\\."
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"match": "\\b[yY]es\\b",
					"name": "storage.modifier"
				},
				{
					"match": "\\b[nN]o\\b",
					"name": "constant.language.boolean.false.tdl"
				}
			]
		}
	},
	"scopeName": "source.tdl"
}