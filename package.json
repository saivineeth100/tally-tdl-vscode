{
    "name": "tally-tdl",
    "displayName": "Tally TDL",
    "description": "TDL support for VS Code",
    "author": "Sai Vineeth",
    "license": "MIT",
    "version": "0.0.1",
    "repository": {
        "type": "git",
        "url": "https://github.com/saivineeth/tally-tdl"
    },
    "publisher": "saivineeth",
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "multi-root ready"
    ],
    "engines": {
        "vscode": "^1.96.0"
    },
    "activationEvents": [
        "onLanguage:xml",
        "workspaceContains:**/*.{tcp,tpj,tdl,tdlxml,xml}"
    ],
    "main": "./client/out/extension",
    "contributes": {
        "chatSkills": [
            {
                "path": "./skills/tally-tdl/SKILL.md"
            }
        ],
        "walkthroughs": [
            {
                "id": "TallyTDLWalkthrough",
                "title": "Tally TDL Development Getting Started",
                "description": "Get started with Tally TDL Development",
                "steps": [
                    {
                        "id": "Configure TDLEnvironment",
                        "title": "Setup TDL Environment",
                        "description": "Setup TDL Environment",
                        "media": {
                            "image": "media/image.png",
                            "altText": "Empty image"
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "tally-tdl.runCurrentFile",
                "title": "Tally TDL: Run Current File",
                "icon": "$(play)"
            },
            {
                "command": "tally-tdl.convertToXml",
                "title": "Tally TDL: Convert to XML"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "when": "resourceLangId == tdl",
                    "command": "tally-tdl.runCurrentFile",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "when": "resourceLangId == tdl",
                    "command": "tally-tdl.convertToXml",
                    "group": "navigation"
                }
            ]
        },
        "languages": [
            {
                "id": "tdl",
                "aliases": [
                    "Tally TDL",
                    "tdl"
                ],
                "extensions": [
                    ".tdl",
                    ".TDL",
                    ".txt",
                    ".tdxml"
                ],
                "configuration": "./tdl.language-configuration.json"
            },
            {
                "id": "xml",
                "extensions": [
                    ".tdlxml",
                    ".TDLXML"
                ]
            }
        ],
        "grammars": [
            {
                "language": "tdl",
                "scopeName": "source.tdl",
                "path": "./syntaxes/tdl.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "tdl",
                "path": "./snippets/tdl.snippets.json"
            },
            {
                "language": "xml",
                "path": "./snippets/tdlxml.snippets.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Tally TDL",
            "properties": {
                "tallyTDL.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VSCode and the language server."
                },
                "tallyTDL.tallyExePath": {
                    "scope": "machine",
                    "type": "string",
                    "default": "C:\\Program Files\\TallyPrime\\tally.exe",
                    "description": "Path to the Tally executable."
                },
                "tallyTDL.tallyCommandLineArgs": {
                    "scope": "machine",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional command line arguments to pass to Tally. The /TDL and file path arguments are added automatically. Use ${file} as a placeholder for the current file path if needed elsewhere."
                }
            }
        },
        "configurationDefaults": {
            "[tdl]": {
                "editor.formatOnType": true
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "eslint .",
        "test": "npm run test -w server"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^8.17.0",
        "@typescript-eslint/parser": "^8.17.0",
        "eslint": "^9.16.0",
        "globals": "^17.6.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.59.4"
    },
    "workspaces": [
        "client",
        "server"
    ]
}