{
    "name": "tally-tdl",
    "version": "0.0.1",
    "displayName": "Tally TDL",
    "description": "TDL support for VS Code",
    "author": "Tallapudi Sai Vineeth",
    "license": "GPL-3.0-or-later",
    "icon": "images/tally-tdl-vscode-logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/saivineeth100/tally-tdl-vscode"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/saivineeth100"
    },
    "publisher": "saivineeth",
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "keywords": [
        "multi-root ready"
    ],
    "engines": {
        "vscode": "^1.96.0"
    },
    "activationEvents": [
        
        "onLanguage:xml",
        "workspaceContains:**/*.{tcp,tpj,tdl,tdlxml,xml}"
    ],
    "main": "./dist/extension",
    "contributes": {
        "chatSkills": [
            {
                "path": "./skills/tally-tdl/SKILL.md"
            }
        ],
        "walkthroughs": [
            {
                "id": "TallyTDLWalkthrough",
                "title": "Tally TDL Development Getting Started",
                "description": "Get started with Tally TDL Development",
                "steps": [
                    {
                        "id": "SetupTallyPath",
                        "title": "1. Select Tally Executable",
                        "description": "Locate your Tally installation. We will try to find it automatically.\n[Select Tally Path](command:tally-tdl.setupTallyPath)",
                        "media": {
                            "image": "media/image.png",
                            "altText": "Empty image"
                        }
                    },
                    {
                        "id": "SetupOdbcPort",
                        "title": "2. Open ODBC Port",
                        "description": "Configure Tally to listen for XML/JSON requests on an available port.\n[Configure Port](command:tally-tdl.setupOdbcPort)",
                        "media": {
                            "image": "media/image.png",
                            "altText": "Empty image"
                        }
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "tally-tdl.runCurrentFile",
                "title": "Tally TDL: Run Current File",
                "icon": "$(play)"
            },
            {
                "command": "tally-tdl.convertToXml",
                "title": "Tally TDL: Convert to XML"
            },
            {
                "command": "tally-tdl.setupTallyPath",
                "title": "Tally TDL: Setup Tally Path"
            },
            {
                "command": "tally-tdl.setupOdbcPort",
                "title": "Tally TDL: Setup ODBC Port"
            },
            {
                "command": "tally-tdl.sendXmlRequest",
                "title": "Tally TDL: Send XML Request",
                "icon": "$(play)"
            },
            {
                "command": "tally-tdl.viewXmlAsTable",
                "title": "Tally: View XML as Table",
                "icon": "$(layout-sidebar-right)"
            },
            {
                "command": "tally-tdl.restartServer",
                "title": "Tally TDL: Restart Language Server",
                "icon": "$(refresh)"
            },
            {
                "command": "tally-tdl.showReferences",
                "title": "Tally TDL: Show References"
            },
            {
                "command": "tally-tdl.showScopeTree",
                "title": "Tally TDL: Show Scope Tree"
            },
            {
                "command": "tally-tdl.buildCustomLibraryCache",
                "title": "Tally TDL: Build Custom TDL Library Cache"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "when": "resourceLangId == tdl",
                    "command": "tally-tdl.runCurrentFile",
                    "group": "navigation"
                },
                {
                    "when": "resourceLangId == xml",
                    "command": "tally-tdl.sendXmlRequest",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "when": "resourceLangId == xml",
                    "command": "tally-tdl.viewXmlAsTable",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "when": "resourceLangId == xml",
                    "command": "tally-tdl.viewXmlAsTable",
                    "group": "navigation"
                },
                {
                    "when": "resourceLangId == tdl",
                    "command": "tally-tdl.convertToXml",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "when": "resourceExtname == .xml",
                    "command": "tally-tdl.viewXmlAsTable",
                    "group": "navigation"
                }
            ]
        },
        "languages": [
            {
                "id": "tdl",
                "aliases": [
                    "Tally TDL",
                    "tdl"
                ],
                "extensions": [
                    ".tdl",
                    ".TDL",
                    ".txt",
                    ".tdxml",
                    ".dat",
                    ".DAT",
                    ".tpj",
                    ".tcp"
                ],
                "configuration": "./tdl.language-configuration.json"
            },
            {
                "id": "xml",
                "extensions": [
                    ".tdlxml",
                    ".TDLXML"
                ]
            }
        ],
        "grammars": [
            {
                "language": "tdl",
                "scopeName": "source.tdl",
                "path": "./syntaxes/tdl.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "tdl",
                "path": "./snippets/tdl.snippets.json"
            },
            {
                "language": "xml",
                "path": "./snippets/tdlxml.snippets.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Tally TDL",
            "properties": {
                "tallyTDL.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VSCode and the language server."
                },
                "tallyTDL.logLevel": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "error",
                        "warn",
                        "info",
                        "debug",
                        "trace"
                    ],
                    "default": "info",
                    "description": "Configures the internal log level of the language server."
                },
                "tallyTDL.externalLibraries": {
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of paths to custom `.bin` library caches generated by 'Build Custom TDL Library Cache'."
                },
                "tallyTDL.tallyExePath": {
                    "scope": "machine",
                    "type": "string",
                    "default": "C:\\Program Files\\TallyPrime\\tally.exe",
                    "description": "Path to the Tally executable."
                },
                "tallyTDL.targetVersion": {
                    "scope": "resource",
                    "type": "string",
                    "default": "7.0",
                    "description": "Target TDL base version for metadata loading (e.g. '7.0'). Changes require reload of cached definitions."
                },
                "tallyTDL.variableTypes": {
                    "type": "object",
                    "default": {
                        "SVFROMDATE": "date",
                        "SVTODATE": "date"
                    },
                    "description": "Map variable names to UI input types (e.g., date, number). Defaults to string if not specified.",
                    "additionalProperties": {
                        "type": "string",
                        "enum": [
                            "string",
                            "number",
                            "date",
                            "company"
                        ]
                    }
                },
                "tallyTDL.tallyPort": {
                    "scope": "resource",
                    "type": "number",
                    "default": 9000,
                    "description": "Port number configured for Tally XML/JSON."
                },
                "tallyTDL.tallyCommandLineArgs": {
                    "scope": "machine",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional command line arguments to pass to Tally. The /TDL and file path arguments are added automatically. Use ${file} as a placeholder for the current file path if needed elsewhere."
                },
                "tallyTDL.excludePaths": {
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "List of regex patterns or paths to fully exclude from scanning (not even parsed for definitions)."
                },
                "tallyTDL.diagnostics.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable or disable Tally TDL diagnostics."
                },
                "tallyTDL.diagnostics.treatWarningsAsErrors": {
                    "type": "boolean",
                    "default": false,
                    "description": "Treat all Tally TDL warnings as errors."
                },
                "tallyTDL.diagnostics.hideWarnings": {
                    "type": "boolean",
                    "default": false,
                    "description": "Hide all Tally TDL warnings."
                },
                "tallyTDL.diagnostics.severity": {
                    "type": "object",
                    "default": {},
                    "description": "Configure severity for specific diagnostic codes.",
                    "additionalProperties": {
                        "type": "string",
                        "enum": [
                            "error",
                            "warning",
                            "information",
                            "hint",
                            "none"
                        ]
                    }
                },
                "tallyTDL.formatting.indentDefinitionBody": {
                    "type": "boolean",
                    "default": true,
                    "description": "Indent content inside definition blocks."
                },
                "tallyTDL.formatting.indentComplexObjectBody": {
                    "type": "boolean",
                    "default": true,
                    "description": "Indent content inside complex object blocks."
                },
                "tallyTDL.formatting.indentBlockStatementBody": {
                    "type": "boolean",
                    "default": true,
                    "description": "Indent procedural block bodies (IF/WHILE/FOR/WALK)."
                },
                "tallyTDL.formatting.spaceBeforeColon": {
                    "type": "string",
                    "enum": ["space", "tab", "none"],
                    "default": "space",
                    "description": "Spacing before ':' in attributes."
                },
                "tallyTDL.formatting.spaceAfterColon": {
                    "type": "string",
                    "enum": ["space", "tab", "none"],
                    "default": "space",
                    "description": "Spacing after ':' in attributes."
                },
                "tallyTDL.formatting.spaceBeforeDefinitionColon": {
                    "type": "string",
                    "enum": ["space", "tab", "none"],
                    "default": "none",
                    "description": "Spacing before ':' in definition headers [Type : Name]."
                },
                "tallyTDL.formatting.spaceAfterDefinitionColon": {
                    "type": "string",
                    "enum": ["space", "tab", "none"],
                    "default": "space",
                    "description": "Spacing after ':' in definition headers [Type : Name]."
                },
                "tallyTDL.formatting.blankLinesBetweenDefinitions": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 5,
                    "description": "Number of blank lines between top-level definitions."
                },
                "tallyTDL.formatting.blankLinesAfterDefinitionHeader": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0,
                    "maximum": 5,
                    "description": "Number of blank lines after definition header before starting attributes."
                },
                "tallyTDL.formatting.blankLinesBetweenAttributes": {
                    "type": "number",
                    "default": -1,
                    "minimum": -1,
                    "maximum": 3,
                    "description": "Number of blank lines between attributes. Set to -1 to preserve original blank lines up to maxConsecutiveBlankLines."
                },
                "tallyTDL.formatting.maxConsecutiveBlankLines": {
                    "type": "number",
                    "default": 2,
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Maximum consecutive blank lines allowed."
                },
                "tallyTDL.formatting.trimTrailingWhitespace": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remove trailing whitespace from lines."
                },
                "tallyTDL.formatting.insertFinalNewline": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ensure file ends with a newline."
                },
                "tallyTDL.formatting.definitionTypeCasing": {
                    "type": "string",
                    "enum": ["preserve", "uppercase", "lowercase", "titlecase"],
                    "default": "preserve",
                    "description": "Casing for definition type keywords (Report, Form, etc.)."
                },
                "tallyTDL.formatting.booleanKeywordCasing": {
                    "type": "string",
                    "enum": ["preserve", "uppercase", "lowercase", "titlecase"],
                    "default": "preserve",
                    "description": "Casing for boolean keywords (Yes/No/True/False)."
                },
                "tallyTDL.formatting.attributeNameCasing": {
                    "type": "string",
                    "enum": ["preserve", "uppercase", "lowercase", "titlecase"],
                    "default": "preserve",
                    "description": "Casing for attribute name keywords."
                },
                "tallyTDL.formatting.spaceAroundOperators": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ensure spaces around binary operators (+, -, *, /, =, etc.)."
                },
                "tallyTDL.formatting.spaceAfterComma": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ensure space after commas in lists."
                }
            }
        },
        "configurationDefaults": {
            "[tdl]": {
                "editor.formatOnType": true
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "npm run typecheck && node esbuild.js && npm run build -w webview-ui",
        "watch": "npm run build -w webview-ui && node esbuild.js --watch",
        "typecheck": "tsc -b",
        "lint": "eslint .",
        "test": "vitest run",
        "package:vsix": "npx @vscode/vsce package --no-dependencies",
        "download-cache": "node scripts/download-cache.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "^20.11.0",
        "@types/sax": "^1.2.7",
        "@typescript-eslint/eslint-plugin": "^8.17.0",
        "@typescript-eslint/parser": "^8.17.0",
        "esbuild": "^0.28.1",
        "eslint": "^9.16.0",
        "globals": "^17.6.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.59.4",
        "vitest": "^4.1.9"
    },
    "workspaces": [
        "client",
        "server",
        "shared",
        "webview-ui"
    ],
    "dependencies": {
        "sax": "^1.6.0"
    }
}
