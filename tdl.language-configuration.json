{
    
    "comments": {
        // symbol used for single line comment. Remove this entry if your language does not support line comments
        "lineComment": ";;",
        // symbols used for start and end a block comment. Remove this entry if your language does not support block comments
        "blockComment": [ "/*", "*/" ]
    },
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+(?:\\s+[^\\`\\~\\!\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)*)",
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<", ">"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        { "open": "/*", "close": " */", "notIn": ["string"] },
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<", ">"],
        ["\"", "\""],
        ["'", "'"]
        
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["<", ">"],
        ["\"", "\""],
        ["'", "'"]
    ],
   "indentationRules": {
    // Rule 1: A line that starts a new block or matches END*/ELSE statement
    // should DECREASE the indent level.
    "decreaseIndentPattern": {
      "pattern": "(?:^\\s*\\[)|(?:^\\s*(?:\\w+\\s*:\\s*)?(?:END\\s*(?:IF|WHILE|WALK|FOR|BLOCK|if|while|walk|for|block)|ELSE|else)\\b)"
    },
    // Rule 2: A line that starts a new block or matches a block statement start
    // should cause the NEXT line to be INDENTED.
    "increaseIndentPattern": {
      "pattern": "(?:^\\s*\\[)|(?:^\\s*(?:\\w+\\s*:\\s*)?(?:IF|WHILE|ELSE|if|while|else)\\s*:)|(?:^\\s*(?:\\w+\\s*:\\s*)?(?:WALK\\s+COLLECTION|FOR\\s+COLLECTION|FOR\\s+TOKEN|FOR\\s+RANGE|START\\s+BLOCK|walk\\s+collection|for\\s+collection|for\\s+token|for\\s+range|start\\s+block)\\b)"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "\\+\\s*$",
      "action": {
        "indentAction": "none"
      }
    }
  ]
}